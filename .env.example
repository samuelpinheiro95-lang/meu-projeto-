# Copie este arquivo para ".env" e preencha.

# Chave da API do Claude (https://console.anthropic.com/settings/keys).
# Sem ela, a seleção de melhores momentos usa um modo automático mais simples
# (baseado no volume do áudio e na fala).
ANTHROPIC_API_KEY=

# Pasta onde os vídeos, legendas e cortes ficam salvos.
# Aponte para um HD externo ou disco grande para vídeos muito pesados.
PASTA_DADOS=./dados

# Modelo de transcrição: tiny, base, small, medium, large-v3
# (maior = mais preciso e mais lento). "small" é um bom equilíbrio.
MODELO_WHISPER=small

# Porta do app no navegador (http://localhost:8000)
PORTA=8000

# Use 1 se tiver placa de vídeo NVIDIA com CUDA instalado (transcrição bem mais rápida).
USAR_GPU=0
